# Base de données
DATABASE_URL=postgres://mizancarbone:changeme@localhost:5432/mizancarbone

# Serveur
PORT=4000
NODE_ENV=development

# Origine autorisée pour le frontend (jamais de wildcard * en production)
CORS_ORIGIN=http://localhost:5173

# JWT — générer une valeur forte, ex: openssl rand -base64 48
JWT_SECRET=changeme-generate-a-strong-random-secret
JWT_EXPIRES_IN=8h

# Cookie de session (auto true si NODE_ENV=production)
COOKIE_SECURE=false
