{
  "name": "mizancarbone-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node-pg-migrate -m src/db/migrations --migration-file-language sql",
    "migrate:up": "node-pg-migrate up -m src/db/migrations --migration-file-language sql",
    "migrate:down": "node-pg-migrate down -m src/db/migrations --migration-file-language sql",
    "seed": "node src/db/seed/run.js",
    "test": "vitest run"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "file-type": "^19.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "puppeteer": "^23.5.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.1"
  }
}
